# --- Secrets: never commit. ------------------------------------------------
# Per-device key material. The keystore is backed up out-of-band, not in git
# (see docs/development-plan.md Phase 12).
db/auth
db/*.db
xAuth_db/
# Firmware secret, baked in at compile time. Only the _example is tracked.
securekey.hpp
firmware/**/include/securekey.hpp

# --- Build output ----------------------------------------------------------
.pio/
build/
*.o
*.a
*.elf
*.bin

# --- Editor / OS -----------------------------------------------------------
# Leading **/ matters: a pattern containing a slash is anchored to this file's
# directory, so a bare ".vscode/launch.json" would miss nested project dirs.
**/.vscode/.browse.c_cpp.db*
**/.vscode/c_cpp_properties.json
**/.vscode/launch.json
**/.vscode/ipch
.DS_Store

# --- Python ----------------------------------------------------------------
__pycache__/
*.pyc
