# Copy to deploy/xauth.env and fill in. Never commit the real one.

# These two are read by docker compose itself, so pass this file with
# `--env-file deploy/xauth.env` as well.
# Host directory holding the keystore file `auth` (chown 10001, chmod 0600).
XAUTH_KEYSTORE_DIR=/srv/xauth/keystore
# openssl rand -hex 32
XAUTH_REDIS_PASSWORD=

AUTH_ORIGIN=https://auth.example.com
ALLOWED_HOSTS=photos.example.com,app.example.com
DEFAULT_REDIRECT=https://photos.example.com/
COOKIE_DOMAIN=example.com
SESSION_TTL_HOURS=12

# Keychains allowed to use the device dashboard at /admin. Comma-separated.
ADMIN_DEVICES=

# ALERT_WEBHOOK_URL=https://ntfy.sh/your-private-topic
