# auth-web settings for the local harness. Loaded by `npm run dev`.
# Plain HTTP on port 8080, so the production defaults are relaxed here.

HOST=127.0.0.1
PORT=3100

AUTH_ORIGIN=http://auth.xauth.test:8080
ALLOWED_HOSTS=app.xauth.test:8080
DEFAULT_REDIRECT=http://app.xauth.test:8080/
ALLOW_HTTP_REDIRECTS=true

COOKIE_DOMAIN=xauth.test
# Browsers drop Secure cookies on plain HTTP. auth-web refuses this setting
# with an https AUTH_ORIGIN, so it cannot leak onto the server.
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# `docker compose -f dev/docker-compose.yml up -d` also starts Redis here.
# Comment out to fall back to in-memory stores.
REDIS_URL=redis://127.0.0.1:6379

# Devices allowed to use /admin. Put your own keychain's ID here.
ADMIN_DEVICES=KJTJ

# Socket paths default to build/verifier.sock and build/admin.sock, which
# dev/up.sh (or make run-verifier / make run-admin) create.
# VERIFIER_SOCKET=
# ADMIN_SOCKET=
